# Backend Configuration
PORT=5000
MONGO_URI=mongodb://mongo:27017/FinalYearProject
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET=your_admin_creation_secret_here

# Frontend Configuration
# VITE_API_URL should be relative (/api) when running in Docker with Vite Proxy
VITE_API_URL=/api

# Proxy target for Vite server (defaults to backend container in Docker)
VITE_API_TARGET=http://backend:5000
